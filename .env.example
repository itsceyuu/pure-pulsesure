# Copy this file to .env on the server and fill in real values.
# NEVER commit .env to Git.
POSTGRES_USER=pulsesure
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD_MIN_24_CHARS
POSTGRES_DB=pulsesure

# Allowed frontend origin: http://SERVER_IP or https://your-domain
CORS_ORIGIN=http://SERVER_IP

# Version label of the AI model (shown in results)
MODEL_VERSION=0.1
