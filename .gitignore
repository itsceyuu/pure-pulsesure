*.jpeg
*.jpg
*.png
*.tif
*.tiff
*.webp
*.pdf
*.ppt
*.pptx

# Repository datasets
# Keep all downloaded, raw, processed, and derived datasets out of GitHub.
/data/
/dataset/
/datasets/
**/data/**/*

# Keep the dataset documentation and empty directory structure in Git while
# continuing to ignore every local/raw/generated measurement file.
!/data/
/data/*
!/data/README.md
!/data/raw/
/data/raw/*
!/data/raw/.gitkeep
!/data/processed/
/data/processed/*
!/data/processed/.gitkeep
!/data/demo/
/data/demo/*
!/data/demo/.gitkeep

# Keep trained models local; version the model selection metadata.
/models/*
!/models/quality_gate_thresholds.json
!/models/waveform_training_metadata.json
!/models/test_metrics_waveform_v2.json
!/models/test_metrics.json

