# Build the frontend (React + Vite) and serve it with nginx.
# Run with the repository root as the build context (see docker-compose.prod.yml).
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY apps/dashboard/package.json apps/dashboard/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/dashboard/ ./
# .env.production already contains VITE_API_URL=/api (routed by nginx below)
ARG VITE_API_URL=/api
ARG VITE_LIVE_MODE=true
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_LIVE_MODE=$VITE_LIVE_MODE
RUN pnpm build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
